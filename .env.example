NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/wastewise?replicaSet=rs0
TEST_MONGODB_URI=mongodb://localhost:27017/wastewise_test?replicaSet=rs0
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-a-different-32-character-secret
COOKIE_SECURE=false
TRUST_PROXY=false
ML_SERVICE_URL=http://127.0.0.1:8000
ML_INTERNAL_API_KEY=replace-with-a-random-secret-at-least-32-characters
CRON_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
MIN_MODEL_RECORDS=28
MIN_BASELINE_RECORDS=7

# Optional locally. In Vercel, use a separate Atlas database/user for model files.
MODEL_MONGODB_URI=
